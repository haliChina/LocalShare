{
  "name": "fileshare",
  "version": "1.0.0",
  "description": "Windows intranet file sharing tool (single .exe, fully offline, Google Drive style)",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "postinstall": "node scripts/copy-assets.js",
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/fileshare.exe",
    "build:win32": "pkg . --targets node18-win-x86 --output dist/fileshare-x86.exe",
    "build:all": "pkg . --targets node18-win-x64,node18-win-x86 --output dist/fileshare"
  },
  "dependencies": {
    "archiver": "5.3.2",
    "busboy": "^1.6.0",
    "ejs": "^3.1.10",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "scripts/**/*.js"
    ],
    "assets": [
      "views/**/*",
      "public/**/*",
      "shared/.gitkeep"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "license": "MIT"
}
