<!DOCTYPE html>
<html lang="zh-Hans" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="典藏室 - 局域网文件共享工具，支持多选上传、拖拽上传、文件夹上传、在线预览图片/视频/音频/代码。">
  <link rel="preload" href="/static/fonts/plex-mono.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/app.css?v=1.0.4">
  <script>
    (function () {
      try {
        var t = localStorage.getItem('fileshare.theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        var t = (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
      }
    })();
  </script>
</head>
<body data-auth="<%= authEnabled ? '1' : '0' %>">

  <!-- Top bar -->
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">
        <span class="brand-logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" fill="currentColor" fill-opacity="0.15"/>
            <circle cx="12" cy="13" r="1.5" fill="currentColor"/>
            <circle cx="16" cy="10" r="1.5" fill="currentColor"/>
            <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
            <line x1="13.2" y1="12.4" x2="14.8" y2="10.6"/>
            <line x1="13.2" y1="13.6" x2="14.8" y2="15.4"/>
          </svg>
        </span>
        <span class="brand-text">
          <span class="brand-title"><%= typeof appName !== 'undefined' ? appName : '典藏室' %></span>
          <span class="brand-sub">内网文件共享 · Intranet Share</span>
        </span>
      </a>

      <div class="address">
        <span class="address-label">访问地址</span>
        <code class="address-host">http://<%= host %>:<%= port %></code>
      </div>

      <div class="meta">
        <button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label="切换主题" title="切换深色/浅色模式">
          <svg class="sun-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="moon-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        <% if (authEnabled) { %>
          <span class="auth-badge" title="已启用 HTTP Basic Auth">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M12 2a5 5 0 0 0-5 5v3H5v12h14V10h-2V7a5 5 0 0 0-5-5zm-3 8V7a3 3 0 0 1 6 0v3H9z"/></svg>
            <span>AUTH</span>
            <span class="auth-user"><%= authUser %></span>
          </span>
        <% } else { %>
          <span class="auth-badge auth-open" title="未启用鉴权">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M12 2a5 5 0 0 0-5 5v3H5v12h14V10h-2V7a5 5 0 0 0-5-5zm-3 8V7a3 3 0 0 1 6 0v3H9z"/></svg>
            <span>公开共享</span>
          </span>
        <% } %>
      </div>
    </div>
  </header>

  <main class="layout">

    <!-- Sidebar -->
    <aside class="sidebar">
      <section class="panel panel-upload">
        <p class="panel-label">Upload / 上传</p>
        <form id="upload-form" method="POST" action="/upload<%= currentDir.relDir ? '/' + currentDir.relDir : '' %>" enctype="multipart/form-data">
          <div class="dropzone" id="dropzone">
            <input type="file" name="files" id="file-input-files" multiple style="display: none;">
            <input type="file" name="files" id="file-input-folders" webkitdirectory directory style="display: none;">
            
            <div class="dropzone-compact">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dropzone-icon">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <div class="dropzone-text-group">
                <span class="dropzone-title">拖拽文件或文件夹至此</span>
                <span class="dropzone-sub">或使用下方按钮选择</span>
              </div>
            </div>

            <div class="upload-buttons">
              <button type="button" id="btn-select-files" class="btn btn-primary btn-block">选取文件</button>
              <button type="button" id="btn-select-folders" class="btn btn-ghost btn-block">选取文件夹</button>
            </div>
          </div>
          <div id="upload-progress" class="upload-progress" hidden>
            <div class="upload-progress-bar"><div class="upload-progress-fill"></div></div>
            <div class="upload-progress-text">就绪</div>
          </div>
        </form>
      </section>

      <section class="panel">
        <p class="panel-label">Tally / 目录统计</p>
        <dl class="stats">
          <div class="stat">
            <dt>文件数量</dt>
            <dd class="stat-num"><%= currentDir.fileCount %></dd>
          </div>
          <div class="stat">
            <dt>文件夹数量</dt>
            <dd class="stat-num"><%= currentDir.folderCount %></dd>
          </div>
          <div class="stat stat-wide">
            <dt>总大小</dt>
            <dd class="stat-num stat-num-sm"><%= currentDir.totalBytesText %></dd>
          </div>
        </dl>
        <% if (currentDir.entries.length > 0) { %>
          <a class="btn btn-ghost btn-block" href="/zip/<%= currentDir.relDir ? encodeURI(currentDir.relDir) : '' %>">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            打包下载当前目录
          </a>
        <% } %>
      </section>

      <section class="panel panel-foot">
        <p class="hint">共享路径 · <code class="hint-path"><%= sharedDir %></code></p>
      </section>
    </aside>

    <!-- Main content -->
    <section class="content">
      
      <!-- Horizontal Breadcrumbs -->
      <nav class="breadcrumbs-horizontal" aria-label="breadcrumb">
        <% currentDir.breadcrumb.forEach(function(c, i) { %>
          <% if (i > 0) { %>
            <span class="crumb-sep" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          <% } %>
          <a class="crumb-item<%= i === currentDir.breadcrumb.length - 1 ? ' is-current' : '' %>" href="<%= href(c.relPath) %>">
            <%= c.name %>
          </a>
        <% }); %>
      </nav>

      <header class="content-head">
        <div class="content-title">
          <h1 class="page-title">
            <% if (currentDir.relDir) { %>
              <%= currentDir.relDir.split('/').pop() %>
            <% } else { %>
              所有文件
            <% } %>
          </h1>
          <p class="page-sub">
            <span class="page-sub-item"><%= currentDir.total %> 项</span>
            <span class="page-sub-item"><%= currentDir.folderCount %> 文件夹</span>
            <span class="page-sub-item"><%= currentDir.fileCount %> 文件</span>
            <% if (currentDir.totalBytesText !== '-') { %>
              <span class="page-sub-item"><%= currentDir.totalBytesText %></span>
            <% } %>
          </p>
        </div>
        <div class="content-tools">
          <div class="search">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input type="search" id="search" placeholder="搜索..." autocomplete="off" spellcheck="false">
            <kbd class="search-kbd">/</kbd>
          </div>
          <div class="view-toggle" role="tablist" aria-label="视图切换">
            <button type="button" data-view="grid" class="view-btn is-active" title="网格" aria-label="网格视图">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M3 3h7v7H3V3zm11 0h7v7h-7V3zM3 14h7v7H3v-7zm11 0h7v7h-7v-7z"/></svg>
            </button>
            <button type="button" data-view="list" class="view-btn" title="列表" aria-label="列表视图">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M3 4h18v3H3V4zm0 7h18v3H3v-3zm0 7h18v3H3v-3z"/></svg>
            </button>
          </div>
        </div>
      </header>

      <% if (currentDir.entries.length === 0) { %>
        <div class="empty">
          <svg class="empty-mark" viewBox="0 0 96 96" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 32v44a4 4 0 0 0 4 4h56a4 4 0 0 0 4-4V40a4 4 0 0 0-4-4H46l-6-8H20a4 4 0 0 0-4 4z" fill="currentColor" fill-opacity="0.04"/>
            <path d="M16 32v44a4 4 0 0 0 4 4h56a4 4 0 0 0 4-4V40a4 4 0 0 0-4-4H46l-6-8H20a4 4 0 0 0-4 4z"/>
            <line x1="28" y1="56" x2="68" y2="56"/>
            <line x1="28" y1="64" x2="58" y2="64"/>
            <line x1="28" y1="72" x2="50" y2="72"/>
          </svg>
          <h2 class="empty-title">本目录暂无内容</h2>
          <p class="empty-text">用左侧上传区把文件加进来，或者直接拖拽文件或文件夹到网页中。</p>
        </div>
      <% } else { %>

        <div id="entries" class="entries view-grid" data-view="grid">
          <% currentDir.entries.forEach(function(e, idx) { %>
            <% if (e.type === 'folder') { %>
              <a class="entry entry-folder" href="<%= href(e.relPath) %>" data-name="<%= e.name.toLowerCase() %>" data-idx="<%= idx %>">
                <div class="entry-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" fill="currentColor" fill-opacity="0.15"/>
                  </svg>
                </div>
                <div class="entry-body">
                  <h3 class="entry-name"><%= e.name %></h3>
                  <p class="entry-meta">
                    <span class="entry-meta-item"><%= e.sizeText %></span>
                    <span class="dot">|</span>
                    <span class="entry-meta-item"><%= e.mtimeText %></span>
                  </p>
                </div>
                <span class="entry-go" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            <% } else { %>
              <div class="entry entry-file" data-name="<%= e.name.toLowerCase() %>" data-kind="<%= e.kind %>" data-rel="<%= e.relPath %>" data-size="<%= e.sizeBytes %>" data-idx="<%= idx %>">
                <button type="button" class="entry-row" data-action="preview" aria-label="预览 <%= e.name %>">
                  <div class="entry-icon entry-icon-<%= e.kind %>" aria-hidden="true">
                    <% if (e.kind === 'image') { %>
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                      </svg>
                    <% } else if (e.kind === 'code') { %>
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 18 22 12 16 6"/>
                        <polyline points="8 6 2 12 8 18"/>
                        <line x1="14" y1="4" x2="10" y2="20"/>
                      </svg>
                    <% } else if (e.kind === 'text') { %>
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                        <polyline points="10 9 9 9 8 9"/>
                      </svg>
                    <% } else if (e.kind === 'archive') { %>
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                      </svg>
                    <% } else if (e.kind === 'audio') { %>
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                        <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                      </svg>
                    <% } else if (e.kind === 'video') { %>
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="23 7 16 12 23 17 23 7"/>
                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                      </svg>
                    <% } else if (e.kind === 'pdf') { %>
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <text x="7" y="17" font-size="6.5" font-family="system-ui" font-weight="800" fill="currentColor">PDF</text>
                      </svg>
                    <% } else { %>
                      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                      </svg>
                    <% } %>
                  </div>
                  <div class="entry-body">
                    <h3 class="entry-name"><%= e.name %></h3>
                    <p class="entry-meta">
                      <span class="entry-kind"><%= e.kind %></span>
                      <span class="dot">|</span>
                      <span class="entry-meta-item"><%= e.sizeText %></span>
                      <span class="dot">|</span>
                      <span class="entry-meta-item"><%= e.mtimeText %></span>
                    </p>
                  </div>
                </button>
                <a class="entry-action" href="/raw/<%= encodeURI(e.relPath) %>" download aria-label="下载 <%= e.name %>" title="下载">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                </a>
              </div>
            <% } %>
          <% }); %>
        </div>

      <% } %>
    </section>
  </main>

  <!-- Preview drawer -->
  <div id="drawer" class="drawer" hidden>
    <div class="drawer-shade" data-action="close"></div>
    <aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
      <header class="drawer-head">
        <div class="drawer-head-text">
          <p class="drawer-eyebrow">Preview / 预览</p>
          <h2 id="drawer-title" class="drawer-title">--</h2>
          <p class="drawer-meta">--</p>
        </div>
        <div class="drawer-actions">
          <a id="drawer-download" class="btn btn-primary" href="#" download>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            下载
          </a>
          <button type="button" class="btn btn-icon" data-action="close" aria-label="关闭">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M19 6.4L17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12 19 6.4z"/></svg>
          </button>
        </div>
      </header>
      <div id="drawer-body" class="drawer-body">
        <div class="drawer-loading">
          <span class="drawer-spinner" aria-hidden="true"></span>
          <span>正在打开...</span>
        </div>
      </div>
    </aside>
  </div>

  <!-- Drag and drop overlay -->
  <div id="drag-overlay" class="drag-overlay" hidden>
    <div class="drag-overlay-box">
      <svg class="drag-overlay-icon" viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="17 8 12 3 7 8"></polyline>
        <line x1="12" y1="3" x2="12" y2="15"></line>
      </svg>
      <h2>释放文件以上传到当前目录</h2>
      <p>支持多选拖拽文件或整个文件夹</p>
    </div>
  </div>

  <script src="/static/js/app.js?v=1.0.4"></script>
</body>
</html>
